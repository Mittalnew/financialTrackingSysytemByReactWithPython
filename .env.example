# Frontend → backend (local API)
VITE_API_URL=http://127.0.0.1:8003
# Email verify/reset links open the API first (works even if Vite is down)
API_PUBLIC_URL=http://127.0.0.1:8003

# ----- Public app URL (login after verify, reset form, auth QR) -----
FRONTEND_URL=http://127.0.0.1:5173
# VITE_PUBLIC_APP_URL=http://127.0.0.1:5173

# CORS (optional). Unset = FRONTEND_URL + local Vite/Docker ports.
# On Render set to your static site origin only:
# CORS_ORIGINS=https://fintrack-web.onrender.com

# PRODUCTION example:
# FRONTEND_URL=https://fintrack-web.onrender.com
# VITE_PUBLIC_APP_URL=https://fintrack-web.onrender.com
# VITE_API_URL=https://fintrack-api.onrender.com
# API_PUBLIC_URL=https://fintrack-api.onrender.com
# SECRET_KEY=long-random-string
# CORS_ORIGINS=https://fintrack-web.onrender.com

# ----- Backend auth -----
# SECRET_KEY=change-me-in-production
# RESEND_API_KEY=
# EMAIL_FROM=Fintrack <onboarding@resend.dev>

# ----- Database -----
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
